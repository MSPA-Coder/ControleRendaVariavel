# Arquivos que nunca devem ocupar espaco nem gerar trafego de sincronizacao no
# Dropbox. Cobre o que e reconstruivel localmente (ambientes virtuais, caches,
# artefatos de build) e o que e sensivel (.env, estado do RTD).
#
# O backup dos bancos e do BackupRestore, que grava fora desta pasta;
# `backups/` nao guarda nada que precise sincronizar.

.git/

# Ambientes virtuais
.venv/
venv/
env/
ENV/

# Caches de ferramentas
__pycache__/
*.pyc
*.pyo
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Artefatos de build
build/
dist/
*.egg
*.egg-info/
tmp/

# Segredos e estado local do host RTD
.env
!.env.example
.secrets/
.certs/
.docker-local/

# Ferramentas de agente
.codex/
.agents/
.claude/
*.mdc

# Editor e sistema operacional
.idea/
*.code-workspace
*.swp
*.swo
.dropbox
.dropbox.cache/
.dropbox.attr

# Temporarios
*.log
*.tmp
*.bak
*.orig
