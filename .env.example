SECRET_KEY=troque-por-um-segredo-longo
RENDA_VARIAVEL_SESSION_COOKIE_NAME=controle_renda_variavel_session
RTD_PROG_ID=rtdtrading.rtdserver
RTD_REFRESH_SECONDS=2
RTD_TIMEOUT_SECONDS=10
RTD_STALE_AFTER_SECONDS=30
RTD_EXCEL_VISIBLE=false

# Usado por scripts/provision-secrets.ps1 para criar .secrets/postgres_password.
# Troque por uma senha própria antes de provisionar; o Compose usa o arquivo,
# não esta variável diretamente.
POSTGRES_PASSWORD=troque-por-uma-senha-forte


# Segurança. Deixe FORCE_HTTPS=false enquanto a aplicação for
# acessada apenas na rede local; ative ao colocar um proxy reverso
# (Caddy/nginx) com TLS na frente (ver README).
FORCE_HTTPS=false
TRUST_PROXY_HEADERS=false
REMOTE_COLLECTOR_ENABLED=false
RATELIMIT_ENABLED=true
# Em memória por padrão (processo único). Para múltiplos workers/gunicorn,
# aponte para um Redis compartilhado, ex.: redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://
