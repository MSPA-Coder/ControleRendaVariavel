# Segredos são gerados/provisionados em .secrets; estes são apenas caminhos.
SECRET_KEY_FILE=.secrets/secret_key
RENDA_VARIAVEL_SESSION_COOKIE_NAME=controle_renda_variavel_session
RTD_PROG_ID=rtdtrading.rtdserver
RTD_REFRESH_SECONDS=2
RTD_TIMEOUT_SECONDS=10
RTD_STALE_AFTER_SECONDS=30

# O script preserva valores legados do .env na primeira migração, mas instalações
# novas geram a senha diretamente no arquivo local.
POSTGRES_PASSWORD_FILE=.secrets/postgres_password


# Segurança. Deixe FORCE_HTTPS=false enquanto a aplicação for
# acessada apenas na rede local; ative ao colocar um proxy reverso
# (Caddy/nginx) com TLS na frente (ver README).
FORCE_HTTPS=false
TRUST_PROXY_HEADERS=false
REMOTE_COLLECTOR_ENABLED=false
RATELIMIT_ENABLED=true
# Em memória por padrão: cada worker do Gunicorn mantém seu próprio contador.
# Em produção, o Nginx central limita o POST /login de forma compartilhada;
# outra topologia exige storage compartilhado ou proteção equivalente no edge.
RATELIMIT_STORAGE_URI=memory://

# De quem e o dinheiro registrado neste sistema, para o resumo publicado em
# GET /patrimonio/v1/resumo. Os dois campos são obrigatórios: titular é a
# identidade externa publicada e owner_id é o usuário financeiro cujo conjunto
# de carteiras será lido. O token vai em .secrets/patrimonio_token.
PATRIMONIO_TITULAR=
PATRIMONIO_OWNER_ID=
# O publicador recusa datas e períodos mais antigos que esta janela.
PATRIMONIO_MAX_HISTORICO_DIAS=3650
